# AI keys can also be saved in the dashboard Settings page instead of here.
# Environment variables take priority over saved keys.
# AI triage provider: openai, anthropic or gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SEMGREP_CONFIG=auto
SCAN_TIMEOUT=300
# Seconds allowed for each AI review, including retries
AI_TIMEOUT=240
MAX_FINDINGS=20
LOG_LEVEL=INFO
